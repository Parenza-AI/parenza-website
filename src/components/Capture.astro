---
/**
 * The logging model. Every claim in CAPTURE_POINTS is a shipped behaviour in
 * the running app; the phone screen renders the quick-entry form's real
 * structure — Started/Ended anchoring, inferred duration, conditional fields.
 */
import PhoneFrame from "./PhoneFrame.astro";
import AppChrome from "./AppChrome.astro";
import { CAPTURE_POINTS, LANGUAGES } from "../data";

const languages = [...LANGUAGES];
const spoken =
  languages.slice(0, -1).join(", ") + " and " + languages[languages.length - 1];
---

<section id="capture" class="px-6 pb-20 lg:pb-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-pz-clay-strong"
      >
        Designed for 3am
      </p>
      <h2
        class="mt-4 font-heading text-3xl font-semibold leading-tight md:text-4xl"
      >
        The log has to survive the night it describes.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-pz-ink-soft">
        A record only helps if it gets written, and it gets written one-handed,
        in the dark, by someone who has not slept. Most of what we build goes
        into removing taps, typing and arithmetic from that moment.
      </p>
    </div>

    <div
      data-reveal
      class="mt-16 flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:gap-20"
    >
      <div class="flex w-full justify-center lg:w-auto lg:shrink-0">
        <PhoneFrame
          label="Parenza feeding entry: a Started or Ended choice, the time, an inferred duration, and only the fields that apply to a bottle feed"
        >
          <AppChrome tab="Routines" subject="Mark" age="6w 3d">
            <div class="px-3 pb-3 pt-3">
              <p
                class="mb-2.5 text-[11px] font-semibold text-pz-night-text"
              >
                Feeding
              </p>

              <div
                class="mb-3 flex rounded-lg border border-pz-night-line p-0.5 text-[10px]"
              >
                <span class="flex-1 py-1.5 text-center text-pz-night-mute"
                  >Started</span
                >
                <span
                  class="flex-1 rounded-md bg-pz-night-card py-1.5 text-center font-semibold text-pz-night-text"
                  >Ended</span
                >
              </div>

              <dl class="space-y-1.5">
                <div
                  class="flex items-center justify-between rounded-lg border border-pz-night-line bg-pz-night-card px-2.5 py-2"
                >
                  <dt class="text-[9px] text-pz-night-mute">Ended</dt>
                  <dd class="text-[10px] font-medium text-pz-night-text">
                    Today · 03:12
                  </dd>
                </div>
                <div
                  class="flex items-center justify-between rounded-lg border border-pz-night-line bg-pz-night-card px-2.5 py-2"
                >
                  <dt class="text-[9px] text-pz-night-mute">Duration</dt>
                  <dd class="text-[10px] font-medium text-pz-night-text">
                    18 min
                  </dd>
                </div>
                <div
                  class="flex items-center justify-between rounded-lg border border-pz-night-line bg-pz-night-card px-2.5 py-2"
                >
                  <dt class="text-[9px] text-pz-night-mute">Type</dt>
                  <dd class="text-[10px] font-medium text-pz-night-text">
                    Bottle (Formula)
                  </dd>
                </div>
                <div
                  class="flex items-center justify-between rounded-lg border border-pz-night-line bg-pz-night-card px-2.5 py-2"
                >
                  <dt class="text-[9px] text-pz-night-mute">Amount</dt>
                  <dd class="text-[10px] font-medium text-pz-night-text">
                    90 ml
                  </dd>
                </div>
              </dl>

              <p class="mt-2.5 text-[9px] leading-relaxed text-pz-night-mute">
                Start time inferred from your recent feeds. Adjust it if the
                night went differently.
              </p>
            </div>
          </AppChrome>
        </PhoneFrame>
      </div>

      <ul class="grid flex-1 gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          CAPTURE_POINTS.map((point) => (
            <li class="border-t border-pz-line-strong pt-5">
              <h3 class="font-heading text-lg font-semibold text-pz-ink">
                {point.title}
              </h3>
              <p class="mt-2.5 text-base leading-relaxed text-pz-ink-soft">
                {point.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-12 max-w-3xl text-sm leading-relaxed text-pz-ink-mute">
      The app speaks {spoken}, in full — which matters when the two people doing
      the nights don't share a first language, and when the guidance you're
      weighing comes from two countries at once.
    </p>

    <p class="mt-4 text-sm text-pz-ink-mute">
      Screens are rendered from the product's real structure. We don't publish
      screenshots of a family's record.
    </p>
  </div>
</section>
